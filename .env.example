# Copy to .env and fill in. Every setting is optional; defaults shown.
# Real environment variables take precedence over this file.

# --- Database (MySQL/MariaDB) ---
GOPOLL_DB_HOST=localhost
GOPOLL_DB_PORT=3306
GOPOLL_DB_USER=user
GOPOLL_DB_PASSWORD=password
GOPOLL_DB_NAME=db

# --- Services to poll ---
# Comma-separated preset names (list them with `./gopoll.py providers`) and/or
# custom GBFS feeds as name=URL. Examples:
#   GOPOLL_PROVIDERS=go_sharing,check_almere
#   GOPOLL_PROVIDERS=go_sharing,felyx_amsterdam,dott_utrecht,mycity=https://example.com/gbfs.json
GOPOLL_PROVIDERS=go_sharing

# --- GO Sharing (goUrban) API; GBFS feeds cover a whole city and ignore these ---
# GOPOLL_API_URL=https://greenmo.core.gourban-mobility.com/front/vehicles
GOPOLL_LAT=52.364431
GOPOLL_LNG=5.222011
# Unit unknown (kept from the original script)
GOPOLL_RADIUS=500
GOPOLL_HTTP_TIMEOUT=20

# --- Movement detection ---
# A vehicle must move at least this many metres (straight line) to be recorded.
GOPOLL_MIN_DISTANCE_M=200
# Also require remainingKilometers to change (filters vehicles moved by staff / GPS drift).
GOPOLL_REQUIRE_RANGE_CHANGE=true

# --- Extras ---
# Which providers also store every vehicle on every poll in `go_snapshot`:
#   gbfs (default) = GBFS providers only; all; none. (true/false still work: all/none.)
# GBFS feeds rotate vehicle ids after each trip, so snapshots are their main data.
# Volume: vehicles x polls, e.g. 1,000 vehicles every 5 min is ~290k rows/day.
GOPOLL_STORE_SNAPSHOTS=gbfs
GOPOLL_LOG_LEVEL=INFO
